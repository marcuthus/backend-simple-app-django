# ==========================================
# Application Configuration
# ==========================================
DEBUG=True
SECRET_KEY="django-insecure-simple-app-change-this-in-production-!@#$"
ALLOWED_HOSTS="*,localhost,127.0.0.1"
CORS_ALLOW_ALL_ORIGINS=True
# Lista de origens permitidas quando CORS_ALLOW_ALL_ORIGINS=False (separadas por vírgula)
CORS_ALLOWED_ORIGINS=""
# Só tem efeito quando CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=False

# Rate limit (formato do DRF: "<n>/<sec|min|hour|day>")
THROTTLE_ANON_RATE="100/min"
THROTTLE_USER_RATE="1000/min"
THROTTLE_AUTH_RATE="20/min"

# ==========================================
# Database Configuration
# ==========================================
# SQLite (Padrão para desenvolvimento local sem containers)
DATABASE_URL="sqlite:///dev.db"

# PostgreSQL (Para Docker / VPS / Produção)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/simple_app_db"

